# Copy to .env and fill in real values — .env itself is gitignored and must never be committed.

MYSQL_DATABASE=wonjaego
MYSQL_USER=wonjaego
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Random 32+ byte secret used to encrypt stored channel API credentials
# (com.wonjaego.channel.CredentialEncryptor). Generate with e.g. `openssl rand -base64 32`.
CHANNEL_ENC_KEY=change-me-to-a-random-secret
