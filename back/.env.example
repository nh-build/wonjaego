# Copy to .env and fill in real values — .env itself is gitignored and must never be committed.

MYSQL_DATABASE=wonjaego
MYSQL_USER=wonjaego
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Random 32+ byte secret used to encrypt stored channel API credentials
# (com.wonjaego.channel.CredentialEncryptor). Generate with e.g. `openssl rand -base64 32`.
CHANNEL_ENC_KEY=change-me-to-a-random-secret

# Gmail SMTP for 아이디찾기/비밀번호 재설정 메일. MAIL_PASSWORD는 일반 Gmail 로그인 비밀번호가
# 아니라 Google 계정의 앱 비밀번호(App Password)여야 한다.
MAIL_USERNAME=change-me@gmail.com
MAIL_PASSWORD=change-me-app-password

# 이 앱 자신의 공개 base URL — 비밀번호 재설정 메일 안 링크를 만드는 데 쓴다.
APP_BASE_URL=http://localhost:8080

# Google Gemini API 키 (AI 상품명 추천, Vision). https://aistudio.google.com 에서 발급.
GEMINI_API_KEY=
